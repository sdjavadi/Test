# copy to .streamlit/secrets.toml and fill in
[app]
mode = "impala"                               # "demo" to run on synthetic clients
bundle_path = "/path/to/attr_model_bundle.joblib"
database = "bdahd01p_dlcdi1_cdi_tm"
months_scored = 3
list_size = 1000
feedback_path = "/path/to/feedback_log.csv"

[impala]
host = "impala-host.example.pnc"
port = 21050
auth_mechanism = "GSSAPI"                     # Kerberos; use "LDAP" with user/password if that is how the cluster is set up
use_ssl = true
kerberos_service_name = "impala"
# user = "..."
# password = "..."
