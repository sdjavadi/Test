# Optional. Copy to .streamlit/secrets.toml to override defaults in pkg_app/config.py (environment variables win over both).
[app]
mode = "impala"                       # or "demo"
bundle_path = "/path/to/attr_model_bundle.joblib"
database = "bdahd01p_dlcdi1_cdi_tm"
list_size = 1000

# Who sees which module: Posit Connect user names or group names; an empty list means everyone.
# Suspicious-activity signals must not reach client-facing staff (tipping-off risk) — confirm the groups with Compliance.
[app.access]
attrition = []
fraud = ["tm-compliance-aml", "tm-leadership"]
network = []
